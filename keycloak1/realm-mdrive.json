{
  "realm": "mdrive",
  "enabled": true,
  "clients": [{
    "clientId": "frontend",
    "enabled": true,
    "publicClient": true,
    "redirectUris": ["http://localhost:5173/*"],
    "webOrigins": ["http://localhost:5173"],
    "standardFlowEnabled": true,
    "protocolMappers": [{
      "name": "auth-source",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "user.session.note": "identity_provider",
        "userinfo.token.claim": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "claim.name": "auth_source",
        "jsonType.label": "String"
      }
    }]
  }],
  "users": [{
    "username": "usuario-kc1",
    "enabled": true,
    "email": "usuario-kc1@example.com",
    "emailVerified": true,
    "firstName": "Usuario",
    "lastName": "Keycloak 1",
    "credentials": [{"type": "password", "value": "kc1pass", "temporary": false}]
  }],
  "identityProviders": [{
    "alias": "keycloak2",
    "displayName": "TopSpin",
    "providerId": "oidc",
    "enabled": true,
    "trustEmail": true,
    "storeToken": false,
    "config": {
      "clientId": "keycloak1-broker",
      "clientSecret": "keycloak1-broker-secret",
      "authorizationUrl": "http://localhost:8082/realms/keycloak2/protocol/openid-connect/auth",
      "tokenUrl": "http://keycloak2:8080/realms/keycloak2/protocol/openid-connect/token",
      "userInfoUrl": "http://keycloak2:8080/realms/keycloak2/protocol/openid-connect/userinfo",
      "logoutUrl": "http://localhost:8082/realms/keycloak2/protocol/openid-connect/logout",
      "defaultScope": "openid profile email",
      "syncMode": "IMPORT",
      "useJwksUrl": "true",
      "jwksUrl": "http://keycloak2:8080/realms/keycloak2/protocol/openid-connect/certs"
    }
  }]
}