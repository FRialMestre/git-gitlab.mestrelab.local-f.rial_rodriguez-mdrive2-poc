{
  "realm": "keycloak2",
  "enabled": true,
  "clients": [{
    "clientId": "keycloak1-broker",
    "name": "Keycloak 1 broker",
    "enabled": true,
    "clientAuthenticatorType": "client-secret",
    "secret": "keycloak1-broker-secret",
    "protocol": "openid-connect",
    "publicClient": false,
    "standardFlowEnabled": true,
    "redirectUris": [
      "http://localhost:8081/realms/mdrive/broker/keycloak2/endpoint",
      "http://localhost:8081/realms/mdrive/broker/keycloak2/endpoint/logout_response",
      "http://localhost:8081/realms/mdrive/broker/keycloak2/endpoint/*"
    ],
    "webOrigins": ["http://localhost:8081"],
    "attributes": {
      "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8081/realms/mdrive/broker/keycloak2/endpoint/*"
    }
  }],
  "users": [{
    "username": "usuario-kc2",
    "enabled": true,
    "email": "usuario-kc2@example.com",
    "emailVerified": true,
    "firstName": "Usuario",
    "lastName": "Keycloak 2",
    "credentials": [{"type": "password", "value": "kc2pass", "temporary": false}]
  }]
}