{
  "realm": "keycloak2",
  "enabled": true,
  "clients": [{
    "clientId": "mdrive-frontend-kc2",
    "name": "MDrive frontend KC2",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["https://mdrive2-poc-ui.mestrelab.local/*"],
    "webOrigins": ["https://mdrive2-poc-ui.mestrelab.local"]
  }, {
    "clientId": "mdrive-broker",
    "name": "Keycloak 1 identity provider",
    "enabled": true,
    "clientAuthenticatorType": "client-secret",
    "secret": "mdrive-broker-secret",
    "protocol": "openid-connect",
    "publicClient": false,
    "standardFlowEnabled": true,
    "redirectUris": [
      "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/broker/keycloak2/endpoint",
      "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/broker/keycloak2/endpoint/*"
    ],
    "webOrigins": ["https://mdrive2-poc-keycloak.mestrelab.local"]
  }, {
    "clientId": "mdrive-token-exchange",
    "name": "MDrive token exchange client",
    "enabled": true,
    "clientAuthenticatorType": "client-secret",
    "secret": "mdrive-token-exchange-secret",
    "protocol": "openid-connect",
    "publicClient": false,
    "standardFlowEnabled": false,
    "serviceAccountsEnabled": false,
    "directAccessGrantsEnabled": false,
    "attributes": {
      "standard.token.exchange.enabled": "true"
    }
  }, {
    "clientId": "spinpilot-api",
    "name": "Spinpilot external API",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "bearerOnly": true,
    "standardFlowEnabled": false,
    "directAccessGrantsEnabled": false
  }],
  "users": [{
    "username": "usuario-kc2",
    "enabled": true,
    "email": "usuario-kc2@example.com",
    "emailVerified": true,
    "firstName": "Usuario",
    "lastName": "Keycloak 2",
    "credentials": [{"type": "password", "value": "kc2pass", "temporary": false}]
  }],
  "identityProviders": [{
    "alias": "keycloak1",
    "displayName": "Keycloak 1",
    "providerId": "oidc",
    "enabled": true,
    "trustEmail": true,
    "storeToken": false,
    "config": {
      "clientId": "mdrive-broker",
      "clientSecret": "mdrive-broker-secret",
      "authorizationUrl": "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/protocol/openid-connect/auth",
      "tokenUrl": "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/protocol/openid-connect/token",
      "userInfoUrl": "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/protocol/openid-connect/userinfo",
      "logoutUrl": "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/protocol/openid-connect/logout",
      "defaultScope": "openid profile email",
      "syncMode": "IMPORT",
      "useJwksUrl": "true",
      "jwksUrl": "https://mdrive2-poc-keycloak.mestrelab.local/realms/mdrive/protocol/openid-connect/certs"
    }
  }]
}